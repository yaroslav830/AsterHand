#!/var/jb/bin/sh
PATH=/var/jb/usr/bin:/var/jb/bin:/var/jb/usr/sbin:/var/jb/sbin:/usr/bin:/bin:/usr/sbin:/sbin
export PATH
app='/var/jb/Applications/PocketCodex.app'
maint="$app/pocketmaint"
launch='/var/jb/usr/bin/launchctl'
labels='local.agentgo.agent local.agentgo.control local.pocketagent.remote local.pocketagent.root local.pocketagent.screen local.pocketagent.overlay local.asterhand.recovery'
case "$1" in
    remove|upgrade|deconfigure)
for label in $labels; do "$launch" disable "system/$label" >/dev/null 2>&1 || true; done
"$maint" stop || true
for label in $labels; do "$launch" bootout "system/$label" >/dev/null 2>&1 || true; done
"$maint" stop || true
        if [ "$1" = remove ]; then
            "$maint" cleanup || true
            "$maint" run 20 '/var/jb/usr/bin/uicache' -u "$app" || true
        fi
        ;;
esac
exit 0
