<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>local.pocketagent.screen</string>
  <key>UserName</key><string>mobile</string>
  <key>GroupName</key><string>mobile</string>
  <key>ProgramArguments</key><array><string>/Applications/PocketCodex.app/pocketscreen</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>ProcessType</key><string>Interactive</string>
  <key>EnvironmentVariables</key><dict><key>_MSSafeMode</key><string>1</string><key>_SafeMode</key><string>1</string><key>HOME</key><string>/var/mobile</string></dict>
  <key>StandardOutPath</key><string>/var/mobile/Library/PocketCodexRemote/screen.log</string>
  <key>StandardErrorPath</key><string>/var/mobile/Library/PocketCodexRemote/screen.log</string>
</dict></plist>
